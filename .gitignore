node_modules/

# Third-party app checkouts live here rather than in this repo's history, so
# each stays on its own upstream and can be pulled independently.
#
# Anchored to the root on purpose: an unanchored "vendor/" matches a directory
# of that name at ANY depth, so it also swallows an app's OWN bundled library —
# apps/<id>/vendor/... — and ships that app missing code it loads at runtime.
# That has already happened twice. Leave the slash on.
/vendor/

*.log
.DS_Store

# App dependencies are installed per app, not committed.
apps/*/node_modules/
